{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nebula": {
      "type": "local",
      "command": ["/path/to/Nebula-Notebook/mcp/run.sh"],
      "enabled": true,
      "environment": {
        "NEBULA_URL": "http://127.0.0.1:8000",
        "NEBULA_MCP_FS_ROOT": "/path/to/your/workspace"
      }
    }
  }
}
