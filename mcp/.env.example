# Nebula MCP server configuration.
# Copy to mcp/.env (chmod 600) or pass these as env in your MCP client config.
NEBULA_URL=http://127.0.0.1:8000

# Prefer a dedicated user created in Administration. Admin credentials are
# only needed for user_*/audit_list tools.
NEBULA_EMAIL=agent@nebula.local
NEBULA_PASSWORD=replace-with-a-12-plus-character-password

# Must be present in the API's ALLOWED_ORIGINS. Defaults to NEBULA_URL.
# NEBULA_ORIGIN=http://127.0.0.1:8000

# Local file operations (import/export/create_file/workspace upload/download)
# are restricted to this directory. Defaults to the MCP server's cwd.
NEBULA_MCP_FS_ROOT=/home/ubuntu/codes

NEBULA_DEFAULT_MODE=cpu
NEBULA_RUN_TIMEOUT=60
# NEBULA_MCP_READONLY=0
# NEBULA_MCP_LOG_LEVEL=WARNING
# Optional PyPI mirror used when mcp/run.sh bootstraps the venv:
# NEBULA_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
