# Copy to .env, replace with your own long random password; never commit .env.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SECURE_COOKIE=false
DATA_DIR=./data
LOGIN_RATE_LIMIT=12
LOGIN_RATE_WINDOW_SECONDS=300
MAX_CPU_SESSIONS_PER_USER=2
MAX_GPU_SESSIONS_PER_USER=1
RUNTIME_MEMORY=2g
RUNTIME_CPUS=2.0
